# Managed by Ansible (roles/chrony_watcher) - do not edit by hand.
[Unit]
Description=Poll log_db for new NTP/chrony breaches fleet-wide and email a summary
After=network.target postgresql.service

[Service]
Type=oneshot
User={{ chrony_watcher_user }}
WorkingDirectory={{ chrony_watcher_app_dir }}
ExecStart=/usr/bin/python3 {{ chrony_watcher_app_dir }}/chrony_watcher.py
