# Managed by Ansible (roles/host_availability_watcher) - do not edit by hand.
[Unit]
Description=Run host-availability-watcher.service every {{ host_availability_watcher_poll_interval_seconds }}s

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ host_availability_watcher_poll_interval_seconds }}s
AccuracySec=5s

[Install]
WantedBy=timers.target
