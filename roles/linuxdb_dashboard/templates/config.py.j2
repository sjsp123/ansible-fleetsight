"""
Generated by roles/linuxdb_dashboard from config.py.j2 - DO NOT EDIT BY HAND,
change the role variables in group_vars/ instead and re-run the playbook.

Deliberately brace-free (no literal `{` or `}`) so it's safe to render
with the `template` module, unlike app.py which is deployed with `copy`.
"""

# hostinfo.csv is produced by roles/hostinfo (delegate_to: localhost, so
# it already lives on this same control node - see host_report_csv_path
# in that role, default /linuxdb/hostinfo, alongside the reports/configs
# data below).
HOSTINFO_CSV_PATH = "{{ linuxdb_dashboard_hostinfo_csv_path }}"

# Populated by roles/linuxdb_reports - same variable, shared between the
# two roles so they always agree on where the data lives.
LINUXDB_REPORTS_DATA_DIR = "{{ linuxdb_reports_data_dir }}"

# Populated by roles/config_snapshot - same variable, shared between the
# two roles so they always agree on where the config file history lives.
CONFIG_SNAPSHOT_DATA_DIR = "{{ config_snapshot_data_dir }}"

# Populated by roles/idm_healthchecks (its idm_hc_dashboard_* feed) - same
# variable, shared between the two roles so they always agree on where
# the IdM healthcheck history lives. See group_vars/all/linuxdb_dashboard.yml
# for why this is duplicated there rather than left as idm_healthchecks'
# own default.
IDM_HEALTHCHECK_DATA_DIR = "{{ idm_hc_dashboard_dir }}"

# (key, label) tuples, in display order - one tab per configured check.
# Kept as a list of tuples (not a dict) so this file needs no curly
# braces anywhere.
CHECKS = [
{% for c in linuxdb_reports_checks %}
    ("{{ c.key }}", "{{ c.label }}"),
{% endfor %}
]

# How many timestamped runs to offer in the history dropdown per check.
MAX_HISTORY_LIST = {{ linuxdb_dashboard_max_history_list }}

# HTTP Basic Auth (see README "Authentication") - checked directly in
# app.py using hmac.compare_digest() from the standard library, no
# session/cookie state. | bool guards against CLI -e extra-vars arriving
# as a raw string rather than a native boolean (same reasoning as
# system_update's reboot-conditional fix elsewhere in this repo).
AUTH_ENABLED = {{ linuxdb_dashboard_auth_enabled | bool }}
AUTH_USER = "{{ linuxdb_dashboard_auth_user }}"
AUTH_PASSWORD = "{{ linuxdb_dashboard_auth_password }}"

# Kerberos authentication mode (optional) - see README "Kerberos
# authentication mode" and group_vars/all/dashboard_auth.yml. When
# AUTH_MODE is "local" (the default) none of these are consulted at all
# - the AUTH_USER/AUTH_PASSWORD check above still applies unchanged.
AUTH_MODE = "{{ linuxdb_dashboard_auth_mode }}"
KERBEROS_REALM = "{{ linuxdb_dashboard_auth_kerberos_realm }}"
KERBEROS_REQUIRED_GROUP = "{{ linuxdb_dashboard_auth_kerberos_required_group }}"
KERBEROS_KINIT_PATH = "{{ linuxdb_dashboard_auth_kerberos_kinit_path }}"
KERBEROS_KDESTROY_PATH = "{{ linuxdb_dashboard_auth_kerberos_kdestroy_path }}"
KERBEROS_GETENT_PATH = "{{ linuxdb_dashboard_auth_kerberos_getent_path }}"
KERBEROS_ID_PATH = "{{ linuxdb_dashboard_auth_kerberos_id_path }}"

# TLS for the standalone stdlib WSGI server (see README "TLS") - read by
# wsgi_standalone_server.py, not by app.py itself. | bool guards against
# CLI -e extra-vars arriving as a raw string rather than a native boolean.
TLS_ENABLED = {{ linuxdb_dashboard_tls_enabled | bool }}
TLS_CERT_PATH = "{{ linuxdb_dashboard_tls_cert_path }}"
TLS_KEY_PATH = "{{ linuxdb_dashboard_tls_key_path }}"

# Optional sibling-app cross-link (see README / defaults/main.yml) - blank
# by default, which app.py's _sibling_link_html() treats as "don't show
# the link".
SIBLING_APP_NAME = "{{ linuxdb_dashboard_sibling_app_name }}"
SIBLING_APP_URL = "{{ linuxdb_dashboard_sibling_app_url }}"
