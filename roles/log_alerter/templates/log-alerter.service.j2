# Managed by Ansible (roles/log_alerter) - do not edit by hand.
[Unit]
Description=Poll log_db for new high-severity log events and email a summary
After=network.target postgresql.service

[Service]
Type=oneshot
User={{ log_alerter_user }}
WorkingDirectory={{ log_alerter_app_dir }}
ExecStart=/usr/bin/python3 {{ log_alerter_app_dir }}/log_alerter.py
