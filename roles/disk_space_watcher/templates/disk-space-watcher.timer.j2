# Managed by Ansible (roles/disk_space_watcher) - do not edit by hand.
[Unit]
Description=Run disk-space-watcher.service every {{ disk_space_watcher_poll_interval_seconds }}s

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ disk_space_watcher_poll_interval_seconds }}s
AccuracySec=5s

[Install]
WantedBy=timers.target
