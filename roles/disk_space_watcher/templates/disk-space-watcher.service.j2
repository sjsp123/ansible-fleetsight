# Managed by Ansible (roles/disk_space_watcher) - do not edit by hand.
[Unit]
Description=Poll log_db for new disk-space/inode threshold breaches fleet-wide and email a summary
After=network.target postgresql.service

[Service]
Type=oneshot
User={{ disk_space_watcher_user }}
WorkingDirectory={{ disk_space_watcher_app_dir }}
ExecStart=/usr/bin/python3 {{ disk_space_watcher_app_dir }}/disk_space_watcher.py
